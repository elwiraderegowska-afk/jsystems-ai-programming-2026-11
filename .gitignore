# Installed skills are restored from skills-lock.json (committed: source, commit and hash
# of every skill), so their copies in .agents/skills/ stay local. Skills written in this
# repository have no external source and are re-included below one by one.
# .claude/skills/ holds the CLI's links to them.
.agents/skills/*
!.agents/skills/evidence-review/
.claude/skills/
__pycache__/
*.pyc
.playwright-cli
playwright-report/
test-results/
playwright/.cache/

# Local Codex history, credentials and runtime state; keep shared config and rules.
.codex/auth.json
.codex/sessions/
.codex/archived_sessions/
.codex/history.jsonl
.codex/session_index.jsonl
.codex/log/
.codex/logs/
.codex/tmp/
.codex/*.sqlite*

# Private agent briefs and Java build artifacts
.agent-briefs/
**/target/
*.class
/.idea
# Playwright CLI output (may contain credentials)
.playwright-cli/
